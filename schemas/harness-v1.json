  "method_version": "transparent-review-v1",
  "privacy_scan": {
    "max_file_bytes": 10485760,
    "max_files": 10000,
    "max_forbidden_value_bytes": 4096,
    "max_forbidden_values": 256,
    "max_tree_bytes": 104857600
  },
  "public_source_scan": {
    "allowed_names": [
      ".env.example"
    ],
    "content_rules": [
      "aws_access_key",
      "bearer_token",
      "openai_style_key",
      "private_key",
      "source_machine_path"
    ],
    "denied_name_prefixes": [
      ".env."
    ],
    "denied_names": [
      ".env"
    ],
    "denied_path_segments": [
      "private",
      "runtime",
      "uploads"
    ],
    "denied_suffixes": [
